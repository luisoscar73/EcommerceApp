@model List<EcommerceApp.Models.CartItem>

@{
    ViewData["Title"] = "Mi carrito";
    decimal total = Model.Sum(item => item.Subtotal);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>🛒 Mi carrito</h1>
            <p class="text-muted">
                Revisa los productos antes de realizar tu compra.
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Seguir comprando
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center p-5">
            <h4>Tu carrito está vacío</h4>
            <p>Agrega algún producto del menú de la cafetería.</p>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                Ver productos
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th class="text-center">Cantidad</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             style="width:70px;
                                                    height:70px;
                                                    object-fit:cover;
                                                    border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <div style="font-size:40px;">☕</div>
                                    }

                                    <strong>@item.Name</strong>
                                </div>
                            </td>

                            <td>Bs @item.Price.ToString("0.00")</td>

                            <td>
                                <div class="d-flex justify-content-center
                                            align-items-center gap-2">

                                    <form asp-action="Decrease" method="post">
                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            −
                                        </button>
                                    </form>

                                    <strong>@item.Quantity</strong>

                                    <form asp-action="Increase" method="post">
                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            +
                                        </button>
                                    </form>
                                </div>
                            </td>

                            <td>
                                Bs @item.Subtotal.ToString("0.00")
                            </td>

                            <td>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card mt-4">
            <div class="card-body text-end">
                <h3>Total: Bs @total.ToString("0.00")</h3>

             <form asp-action="Checkout"
      method="post"
      class="mt-3">

    <button type="submit"
            class="btn btn-success btn-lg"
            onclick="return confirm('¿Confirmar esta compra?')">
        ✅ Confirmar compra
    </button>
</form>
            </div>
        </div>
    }
</div>
