@model EcommerceApp.Models.Sale

@{
    ViewData["Title"] = "Detalle de compra";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <div class="d-flex justify-content-between
                        align-items-center">

                <div>
                    <h3 class="mb-1">
                        🧾 Compra #@Model.Id
                    </h3>

                    <small>
                       @(Model.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                    </small>
                </div>

                <span class="badge bg-success">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="card-body">
            @if (isAdmin)
            {
                <div class="alert alert-secondary">
                    <strong>Cliente:</strong>
                    @(Model.Customer?.FullName ?? "Cliente")

                    <br />

                    <strong>Correo:</strong>
                    @Model.Customer?.Email
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var detail in Model.Details)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex
                                                align-items-center gap-3">

                                        @if (!string.IsNullOrEmpty(
                                            detail.Product?.ImageUrl))
                                        {
                                            <img src="@detail.Product.ImageUrl"
                                                 alt="@detail.Product.Name"
                                                 style="width:60px;
                                                        height:60px;
                                                        object-fit:cover;
                                                        border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <span style="font-size:35px;">
                                                ☕
                                            </span>
                                        }

                                        <strong>
                                            @(detail.Product?.Name
                                                ?? "Producto eliminado")
                                        </strong>
                                    </div>
                                </td>

                                <td class="text-center">
                                    @detail.Quantity
                                </td>

                                <td>
                                    Bs @detail.UnitPrice.ToString("0.00")
                                </td>

                                <td>
                                    Bs @detail.Subtotal.ToString("0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end mt-4">
                <h3>
                    Total: Bs @Model.Total.ToString("0.00")
                </h3>
            </div>
        </div>

        <div class="card-footer">
            @if (isAdmin)
            {
                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al panel de ventas
                </a>
            }
            else
            {
                <a asp-action="MyPurchases"
                   class="btn btn-secondary">
                    Volver a mis compras
                </a>
            }
        </div>
    </div>
</div>