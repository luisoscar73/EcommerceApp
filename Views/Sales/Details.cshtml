@model EcommerceApp.Models.Sale

@{
    ViewData["Title"] = "Detalle de compra";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <div class="d-flex justify-content-between
                        align-items-center">

                <div>
                    <h3 class="mb-1">
                        🧾 @(Model.InvoiceNumber
                            ?? $"Compra #{Model.Id}")
                    </h3>

                    <small>
                       Emisión:
                       @((Model.IssuedAt ?? Model.SaleDate)
                           .AddHours(-4)
                           .ToString("dd/MM/yyyy HH:mm"))
                    </small>
                </div>

                <span class="badge bg-success">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="alert alert-secondary h-100 mb-0">
                        <strong>Nombre o razón social:</strong>
                        @(Model.BillingName
                            ?? Model.Customer?.FullName
                            ?? "Cliente")

                        <br />

                        <strong>NIT/CI:</strong>
                        @(Model.TaxId ?? "No registrado")

                        <br />

                        <strong>Correo:</strong>
                        @(Model.Customer?.Email ?? "No registrado")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="alert alert-secondary h-100 mb-0">
                        <strong>Método de pago:</strong>
                        @(Model.Payment?.Method ?? "No registrado")

                        <br />

                        <strong>Referencia:</strong>
                        @(Model.Payment?.Reference ?? "-")

                        <br />

                        <strong>Conciliación:</strong>
                        @(Model.Payment?.ReconciliationStatus
                            ?? "No registrada")

                        @if (Model.Payment?.ReconciledAt != null)
                        {
                            <br />
                            <strong>Fecha y hora:</strong>
                            @(Model.Payment.ReconciledAt.Value
                                .AddHours(-4)
                                .ToString("dd/MM/yyyy HH:mm"))
                        }
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var detail in Model.Details)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex
                                                align-items-center gap-3">

                                        @if (!string.IsNullOrEmpty(
                                            detail.Product?.ImageUrl))
                                        {
                                            <img src="@detail.Product.ImageUrl"
                                                 alt="@detail.Product.Name"
                                                 style="width:60px;
                                                        height:60px;
                                                        object-fit:cover;
                                                        border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <span style="font-size:35px;">
                                                ☕
                                            </span>
                                        }

                                        <strong>
                                            @(detail.Product?.Name
                                                ?? "Producto eliminado")
                                        </strong>
                                    </div>
                                </td>

                                <td class="text-center">
                                    @detail.Quantity
                                </td>

                                <td>
                                    Bs @detail.UnitPrice.ToString("0.00")
                                </td>

                                <td>
                                    Bs @detail.Subtotal.ToString("0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end mt-4">
                @if (Model.Payment != null)
                {
                    <div class="text-muted">
                        Comisión
                        (@(Model.Payment.CommissionRate.ToString("0.##"))%):
                        Bs @Model.Payment.CommissionAmount.ToString("0.00")
                    </div>
                }

                <h3>
                    Total: Bs @Model.Total.ToString("0.00")
                </h3>
            </div>
        </div>

        <div class="card-footer">
            <a asp-action="SalePdf"
               asp-route-id="@Model.Id"
               class="btn btn-success me-2">
                Descargar comprobante PDF
            </a>

            @if (isAdmin)
            {
                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al panel de ventas
                </a>
            }
            else
            {
                <a asp-action="MyPurchases"
                   class="btn btn-secondary">
                    Volver a mis compras
                </a>
            }
        </div>
    </div>
</div>
