@model List<EcommerceApp.Models.Sale>

@{
    ViewData["Title"] = "Panel de ventas";

    decimal totalIncome = Model.Sum(s => s.Total);

    int productsSold = Model
        .SelectMany(s => s.Details)
        .Sum(d => d.Quantity);
}

<div class="container py-4">
    <div class="d-flex justify-content-between
                align-items-center mb-4">
        <div>
            <h1>📊 Panel de ventas</h1>
            <p class="text-muted">
                Resumen de las ventas realizadas en la cafetería.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Reports"
               asp-action="Index"
               class="btn btn-success">
                Abrir reportes
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-primary">
                Ver inventario
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <h6>Ventas realizadas</h6>
                    <h2>@Model.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <h6>Ingresos registrados</h6>
                    <h2>Bs @totalIncome.ToString("0.00")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning h-100">
                <div class="card-body">
                    <h6>Productos vendidos</h6>
                    <h2>@productsSold</h2>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no se registraron ventas.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Factura</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Productos</th>
                                <th>Estado</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var sale in Model)
                            {
                                <tr>
                                    <td>
                                        @(sale.InvoiceNumber
                                            ?? $"Venta #{sale.Id}")
                                    </td>

                                    <td>
                                        <strong>
                                            @(sale.Customer?.FullName
                                                ?? "Cliente")
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @sale.Customer?.Email
                                        </small>
                                    </td>

                                    <td>
                                        @(sale.SaleDate.AddHours(-4).ToString("dd/MM/yyyy HH:mm"))
                                    </td>

                                    <td>
                                        @sale.Details.Sum(d => d.Quantity)
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @sale.Status
                                        </span>
                                    </td>

                                    <td>
                                        Bs @sale.Total.ToString("0.00")
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@sale.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
