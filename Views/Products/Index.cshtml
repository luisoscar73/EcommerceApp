@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Menú";
    bool isAdmin = User.IsInRole("Admin");

    var productsToShow = isAdmin
        ? Model.ToList()
        : Model.Where(p => p.IsAvailable && p.Stock > 0).ToList();
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1>☕ Menú de la cafetería</h1>
            <p class="text-muted mb-0">
                Consulta nuestros productos disponibles.
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (isAdmin)
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    Registrar producto
                </a>

                <a asp-action="LowStock"
                   class="btn btn-warning">
                    ⚠ Stock bajo
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-success">
                    🛒 Ver carrito
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">
                        Buscar producto
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Ejemplo: café, sándwich..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Categoría
                    </label>

                    <select name="category"
                            class="form-select">

                        <option value="">
                            Todas las categorías
                        </option>

                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var category in ViewBag.Categories)
                            {
                                @if (ViewBag.Category == category)
                                {
                                    <option value="@category" selected>
                                        @category
                                    </option>
                                }
                                else
                                {
                                    <option value="@category">
                                        @category
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex
                            align-items-end gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        🔍 Buscar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (productsToShow.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron productos.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in productsToShow)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height:220px;
                                        object-fit:cover;" />
                        }
                        else
                        {
                            <div class="text-center bg-light py-5"
                                 style="font-size:75px;">
                                ☕
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between
                                        align-items-start gap-2">
                                <h4 class="card-title">
                                    @product.Name
                                </h4>

                                @if (!string.IsNullOrEmpty(product.Category))
                                {
                                    <span class="badge bg-secondary">
                                        @product.Category
                                    </span>
                                }
                            </div>

                            <p class="card-text text-muted">
                                @product.Description
                            </p>

                            <h4 class="text-success mt-auto">
                                Bs @product.Price.ToString("0.00")
                            </h4>

                            @if (isAdmin)
                            {
                                <p class="mb-2">
                                    Stock:
                                    <strong>@product.Stock</strong>
                                    | Mínimo:
                                    <strong>@product.MinimumStock</strong>
                                </p>

                                @if (product.Stock <= product.MinimumStock)
                                {
                                    <div class="alert alert-warning py-2">
                                        ⚠ Stock bajo
                                    </div>
                                }

                                @if (!product.IsAvailable)
                                {
                                    <span class="badge bg-danger mb-3">
                                        No disponible
                                    </span>
                                }

                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-warning">
                                        Editar
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-info">
                                        Detalles
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@product.Id"
                                       class="btn btn-danger">
                                        Eliminar
                                    </a>
                                </div>
                            }
                            else if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post"
                                      class="mt-3">

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        🛒 Añadir al carrito
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-outline-primary mt-3">
                                    Inicia sesión para comprar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>