@{
    ViewData["Title"] = "Privacidad";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h1>Privacidad</h1>
            <p class="text-muted">
                Este sistema académico utiliza los datos registrados
                únicamente para gestionar cuentas, compras, comprobantes
                e informes de la Cafetería UPDS.
            </p>

            <h2 class="h4 mt-4">Datos utilizados</h2>
            <p>
                Nombre, correo, dirección opcional, NIT o CI de facturación
                y referencias de pago ingresadas por el usuario.
            </p>

            <h2 class="h4 mt-4">Uso del micrófono</h2>
            <p>
                El asistente de voz solo se activa cuando presionas el botón
                del micrófono y el navegador solicita tu autorización.
            </p>

            <p class="mb-0">
                Proyecto educativo de Ingeniería en Sistemas.
            </p>
        </div>
    </div>
</div>
